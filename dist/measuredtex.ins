%% measuredtex.ins
%% Installer for the measuredtex package.
%%
%% Run: latex measuredtex.ins
%%
\input docstrip.tex
\keepsilent
\askforoverwritefalse

\preamble

measuredtex.sty -- Semantic markup for measurement models.
Copyright (c) 2026 Measurement Standards Laboratory of New Zealand.
MIT License.

\endpreamble

\generate{%
  \file{measuredtex.sty}{\from{measuredtex.dtx}{package}}%
}

\obeyspaces
\Msg{*************************************************************************}
\Msg{*                                                                       *}
\Msg{* To finish the installation, the measuredtex.sty                       *}
\Msg{* file should be moved into a directory searched by TeX.                *}
\Msg{*                                                                       *}
\Msg{* To produce the documentation, run:                                    *}
\Msg{*   pdflatex measuredtex.dtx                                            *}
\Msg{*   makeindex -s gind.ist measuredtex.idx                               *}
\Msg{*   makeindex -s gglo.ist -o measuredtex.gls measuredtex.glo            *}
\Msg{*   pdflatex measuredtex.dtx                                            *}
\Msg{*                                                                       *}
\Msg{*************************************************************************}

\endbatchfile
